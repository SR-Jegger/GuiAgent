{
  "version": "1.0",
  "description": "多步骤任务规则示例",
  "rules": [
    {
      "id": "open_file_explorer",
      "name": "打开文件资源管理器",
      "description": "使用 Win+E 快捷键打开文件资源管理器",
      "trigger": {
        "patterns": [
          ".*打开文件资源管理器.*",
          ".*打开我的电脑.*",
          ".*打开资源管理器.*"
        ]
      },
      "actions": [
        {
          "type": "hotkey",
          "keys": ["win", "e"]
        }
      ],
      "enabled": true
    },
    {
      "id": "input_text_field",
      "name": "在输入框输入文本",
      "description": "在任务名称输入框中输入指定文本",
      "trigger": {
        "patterns": [
          ".*任务名称一栏输入 (.*)",
          ".*在任务名称输入 (.*)",
          ".*输入任务名称为 (.*)"
        ]
      },
      "actions": [
        {
          "type": "left_click",
          "coordinate": [1080, 570]
        },
        {
          "type": "type",
          "text": "{{match_group_1}}"
        }
      ],
      "enabled": false
    },
    {
      "id": "demo_browser_desktop_mix_rule",
      "name": "演示:浏览器+桌面混合 skill",
      "description": "同一个 skill 的 actions 列表中混合 browser_* 与桌面动作。Playwright 部分(导航/填充/点击/等待)作用于 DOM,桌面部分(双击/输入)作用于操作系统。正则捕获支持 {0} 与 {{match_group_1}} 两种占位符。",
      "trigger": {
        "patterns": [
          ".*混合搜索 ([\\w\\u4e00-\\u9fa5]+).*"
        ]
      },
      "actions": [
        {"action": "browser_navigate", "url": "http://localhost:3000/"},
        {"action": "browser_wait_idle"},
        {"action": "browser_fill", "selector": "#search-box", "value": "{0}"},
        {"action": "browser_click", "selector": "#search-btn"},
        {"action": "browser_wait_selector", "selector": ".results", "state": "visible"},
        {"type": "double_click", "coordinate": [500, 300], "coordinate_normalized": true},
        {"type": "type", "text": "搜索完成,关键词为 {{match_group_1}}"}
      ],
      "enabled": true
    }
  ]
}
