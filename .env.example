# LLM Configuration for GuiAgent Skill Learning
# Copy this file to .env and fill in your configuration

# ==============================================================================
# LLM API Configuration
# ==============================================================================

# For OpenAI official API:
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o-mini

# For local models (Ollama example):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:32b

# For other compatible providers:
# - DeepSeek: https://api.deepseek.com/v1
# - Moonshot: https://api.moonshot.cn/v1
# - Minimax: https://api.minimax.chat/v1

# ==============================================================================
# LLM Clustering Configuration
# ==============================================================================

# Embedding model for semantic similarity
# Options:
#   - paraphrase-multilingual-MiniLM-L12-v2 (recommended for Chinese)
#   - paraphrase-MiniLM-L3-v2 (smaller, faster)
#   - all-MiniLM-L6-v2 (English optimized)
LLM_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Semantic similarity threshold (0-1)
# Higher = stricter clustering (fewer, more similar clusters)
# Lower = looser clustering (more clusters, may include less similar items)
LLM_SIMILARITY_THRESHOLD=0.75

# Minimum operations to form a cluster
LLM_MIN_CLUSTER_SIZE=3

# ==============================================================================
# LLM Reviewer Configuration
# ==============================================================================

# Auto-approve threshold (confidence 0-1)
# Candidates with confidence >= this value and low risk will be auto-approved
LLM_AUTO_APPROVE_THRESHOLD=0.75

# Minimum quality score for auto-approve (0-100)
LLM_MIN_QUALITY_SCORE=70

# Language hint for prompts (zh/en, auto-detected if not set)
# LLM_LANGUAGE=zh

# ==============================================================================
# Usage Examples
# ==============================================================================

# 1. Trigger LLM clustering:
#    curl -X POST http://localhost:8000/api/v1/skills/cluster/llm

# 2. Review candidate with LLM:
#    curl -X POST http://localhost:8000/api/v1/skills/candidates/cluster_xxx/review

# 3. Auto-approve candidate (if LLM recommends):
#    curl -X POST http://localhost:8000/api/v1/skills/candidates/cluster_xxx/auto-approve

# 4. Get review queue (candidates needing human review):
#    curl http://localhost:8000/api/v1/skills/review-queue
